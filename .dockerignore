# Everything the image does not need. A smaller context is a faster build and a smaller
# attack surface.
.git
.github
**/*_test.go
**/testdata
# The .proto files are only used by `make proto`; internal/pb is what the build compiles.
api/
test/
docs/
*.md
Makefile
Dockerfile
.dockerignore
.env
.env.*
coverage.out
bin/
